{
  "name": "foerderprogramm-finder",
  "version": "1.1.0",
  "private": true,
  "description": "KI-gestützter Finder für deutsche Förderprogramme (mpool Consulting)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "catalog:demo": "tsx --env-file=.env.local scripts/catalog.ts demo",
    "catalog:ingest": "tsx --env-file=.env.local scripts/catalog.ts ingest",
    "catalog:preview": "tsx --env-file=.env.local scripts/catalog.ts preview",
    "catalog:digest": "tsx --env-file=.env.local scripts/catalog.ts digest",
    "catalog:priority": "tsx --env-file=.env.local scripts/catalog.ts priority",
    "catalog:priority-preview": "tsx --env-file=.env.local scripts/catalog.ts priority-preview",
    "search:quality": "tsx --env-file=.env.local scripts/search-quality.ts",
    "benchmark": "tsx --env-file=.env.local scripts/benchmark.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "next": "^14.2.35",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.26.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.5.8",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  }
}
