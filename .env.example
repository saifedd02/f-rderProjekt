# Copy to .env.local and fill in your keys. .env.local is git-ignored.
# At least one search key (Perplexity or Gemini) is required; GEMINI_API_KEY
# is additionally needed for the per-program chat.

# ── Web search (primary): Perplexity Sonar ───────────────────────────
# Get a key at https://www.perplexity.ai/settings/api
# When set, the finder uses Perplexity (sonar-pro) as the primary search engine:
# structured JSON output + per-source search_results (precise per-program links).
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Optional: override the Sonar model (default: sonar-pro)
# PERPLEXITY_MODEL=sonar-pro

# Optional: restrict search to official domains. Default is a built-in allowlist
# of official German/EU funding portals (foerderdatenbank.de, kfw.de, bafa.de,
# bmwk.de, …) which improves precision and link quality. Set to "off" to disable,
# or provide a comma-separated list to override.
# PERPLEXITY_DOMAIN_FILTER=foerderdatenbank.de,kfw.de,bafa.de

# Optional: bias search toward recent sources (hour|day|week|month|year). Off by default.
# PERPLEXITY_RECENCY=year

# ── Web search (fallback): Google Gemini ──────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
# Used when Perplexity is unavailable or fails. Also powers the per-program chat.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: choose a different Gemini model
GEMINI_MODEL=gemini-3.1-flash-lite

# ── App ───────────────────────────────────────────────────────────────
# Public base URL of the deployment.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Förderradar: Katalog & Alerts ─────────────────────────────────────
# Der tägliche Lauf lädt den Förderdatenbank-Export (~28 MB, CC BY 4.0) und die
# offenen EU-Calls, vergleicht sie mit dem Vortag und legt Treffer für den
# wöchentlichen Digest ab. Ohne DATABASE_URL bleiben Suche und Chat unberührt —
# es laufen dann nur Katalog und Alerts nicht.

# Postgres (Vercel Postgres / Neon). POSTGRES_URL wird ebenfalls akzeptiert.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Gemeinsames Geheimnis für /api/cron/* und /api/alerts/preview.
# Vercel Cron sendet es als "Authorization: Bearer …"; manuell geht ?secret=…
# Erzeugen: openssl rand -hex 32
CRON_SECRET=

# E-Mail-Versand über Resend (https://resend.com). Absenderdomain muss dort
# verifiziert sein, sonst landet der Digest im Spam.
RESEND_API_KEY=
ALERT_FROM="mpool Förderradar <foerderradar@mpool-consulting.de>"
# Komma-getrennte Empfängerliste.
ALERT_RECIPIENTS=

# Wochentag des Versands (0 = Sonntag, 1 = Montag). Der Cron läuft täglich und
# verschickt nur an diesem Tag — so funktioniert der Digest auch auf Plänen,
# die nur tägliche Cron-Zeitpläne erlauben.
DIGEST_WEEKDAY=1

# ── Förderradar: Prioritätsalarm ──────────────────────────────────────
# Direkt nach jedem erfolgreichen täglichen Ingest: nur NEUE Programme, deren
# bester mpool-Themen-Score den Grenzwert erreicht, stärkste Treffer zuerst.
# Versand an ALERT_RECIPIENTS über dieselben Resend-Variablen wie der Digest.
# Der erste Katalogaufbau meldet nichts; bereits gemeldete Programme nie erneut.

# true oder false. Leer = an. Ein ungültiger Wert schaltet den Alarm AUS.
PRIORITY_ALERT_ENABLED=true

# Mindest-Score als ganze Zahl von 0 bis 100. Ungültig oder leer = 70.
PRIORITY_ALERT_THRESHOLD=70

# Höchstens so viele Programme pro Mail, ganze Zahl von 1 bis 50.
# Weitere Treffer über dem Grenzwert erscheinen im Wochen-Digest. Ungültig = 10.
PRIORITY_ALERT_MAX_ENTRIES=10
