# ── Web search (primary): Perplexity Sonar ───────────────────────────
# Get a key at https://www.perplexity.ai/settings/api
# When set, the finder uses Perplexity (sonar-pro) as the primary search engine:
# structured JSON output + per-source search_results (precise per-program links).
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Optional: override the Sonar model (default: sonar-pro)
# PERPLEXITY_MODEL=sonar-pro

# Optional: restrict search to official domains. Default is a built-in allowlist
# of official German/EU funding portals (foerderdatenbank.de, kfw.de, bafa.de,
# bmwk.de, …) which improves precision and link quality. Set to "off" to disable,
# or provide a comma-separated list to override.
# PERPLEXITY_DOMAIN_FILTER=foerderdatenbank.de,kfw.de,bafa.de

# Optional: bias search toward recent sources (hour|day|week|month|year). Off by default.
# PERPLEXITY_RECENCY=year

# ── Web search (fallback): Google Gemini ──────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
# Used when Perplexity is unavailable or fails. Also powers the per-program chat.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: choose a different Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Base URL for the app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
